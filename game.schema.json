{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-game-engine/schema/project-v0.3.json",
  "title": "Hermes Game Engine Project V0.3",
  "type": "object",
  "required": ["version", "id", "name", "currentSceneId", "scenes", "behaviors", "assets"],
  "properties": {
    "version": { "const": "0.3.0" },
    "id": { "type": "string" },
    "name": { "type": "string" },
    "currentSceneId": { "type": "string" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "settings", "tilemap", "entities"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "settings": { "type": "object" },
          "tilemap": { "type": "object" },
          "entities": { "type": "array" }
        }
      }
    },
    "behaviors": { "type": "array" },
    "assets": { "type": "array" },
    "metadata": { "type": "object" }
  }
}
