# Lakebase Postgres / Neon
# Use a connection string whose database is hermes_game_engine.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/hermes_game_engine?sslmode=require

# Private token required by all write/read cloud API routes.
HGE_API_TOKEN=replace-with-a-long-random-secret

# Optional: Hermes image/sprite generation endpoint.
# POST receives {kind,prompt,name,transparent,size}
# and may return {url} or {base64,mediaType,model,provider}.
HERMES_ASSET_ENDPOINT=
HERMES_ASSET_TOKEN=

# Neon Object Storage — bucket already provisioned as hge-assets.
HGE_ASSET_BUCKET=hge-assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
